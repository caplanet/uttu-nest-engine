-            if !usable
-                || (api.get_lp_sol)(
-                    prob,
-                    x.as_mut_ptr(),
-                    std::ptr::null_mut(),
-                    std::ptr::null_mut(),
-                    std::ptr::null_mut(),
-                ) != 0
-            {
-                x.clear();
-            }
-
-            let _ = (api.destroy_prob)(prob);
-
-            if opt_rc != 0 && status == LpStatus::Failed {
-                return Err(format!("XPRSlpoptimize 가 {opt_rc} 를 돌려줬다"));
-            }
