-                crate::util::frozen::restore(&mut h.prob, &solution);
-                h.solutions.clear();
-                h.solutions.push(solution.clone());
-                h.solution = Some(solution);
-                h.structure_report = Some(report);
-                h.phase = Phase::Structure;
