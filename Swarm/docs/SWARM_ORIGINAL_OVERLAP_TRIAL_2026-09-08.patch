-/// 추가할 수 있게 한다.
-enum HandleEngine {
-    Legacy(LegacyStepState),
-    Grouped(GroupedHandleState),
-}
-
-impl HandleEngine {
-    fn legacy_mut(&mut self) -> &mut LegacyStepState {
-        match self {
-            Self::Legacy(state) => state,
-            Self::Grouped(_) => panic!("legacy state requested from a grouped handle"),
-        }
-    }
