+        let second_payload = cache
+            .borrow()
+            .certified
+            .as_ref()
+            .unwrap()
+            .payload
+            .as_ref()
+            .unwrap()
+            .as_ptr();
+        assert_eq!(first_payload, second_payload);
+    }
+}
