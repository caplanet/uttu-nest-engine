-            warn!("[STRUCT:P5] angle snap could not be repaired; restoring incumbent");
-            p5_sep = Separator::new(
-                instance.clone(),
-                restored_problem(&instance, &before_p5),
-                p5_polish_rng,
-                p5_sep_cfg,
-            );
-            p5_sep.configure_reinsertion(nfp_integration);
-            p5_sep.freeze_items(frozen_item_ids);
-            p5_seed = before_p5.clone();
-        }
-    }
-    let polished = polish_phase_with_nfp(
-        &instance,
-        &mut p5_sep,
-        &p5_seed,
-        &mut sol_listener,
-        terminator,
-        polish_config,
-        nfp_integration,
-        lp_solver,
-    );
-    consider_p5_incumbent(&instance, &mut incumbent, &polished, &mut best_stage);
-    if terminator.stop_requested() {
-        return Ok(finish_structure_report(
-            report, incumbent, best_stage, &instance, started, true,
-        ));
-    }
-    push_checkpoint(
-        &mut report,
-        StructureStage::P5Finish,
-        &polished,
-        &incumbent,
-        &instance,
-        &config,
-        started,
-    );
-
-    report_stage_milestone(
-        &mut sol_listener,
-        &mut milestone_listener,
-        StructureStage::P5Finish,
-        ReportType::Final,
-        &incumbent,
-        &instance,
-    );
-    let result = finish_structure_report(report, incumbent, best_stage, &instance, started, false);
-    info!(
-        "[STRUCT] finished at {:.3} ({:.3}%), incumbent from {:?}",
-        result.1.final_width,
