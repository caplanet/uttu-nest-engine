+                    "[POLISH] rejecting candidate before callback: exact/constraint validation failed"
+                );
+                sep.rollback(&best_sol, None);
+                exit = PolishExit::RolledBackInfeasible;
+                break;
+            }
+            best_sol = sol;
+            if width_improved {
+                if let Some(l) = sol_listener.as_deref_mut() {
+                    l.report(ReportType::CmprFeas, &best_sol, instance);
+                }
+            }
+        }
+        total_changes += changes.max(usize::from(pose_changed));
+        round += 1;
+        if term.kill() {
+            exit = PolishExit::Killed;
+            break;
+        }
+        unchanged_rounds = if pose_changed {
+            0
+        } else {
+            unchanged_rounds + 1
+        };
+        if unchanged_rounds >= config.n_rounds.max(1) {
+            exit = PolishExit::NoChanges;
+            break;
+        }
+        if round >= config.n_rounds.max(1) && !width_improved && pose_changed {
+            exit = PolishExit::RoundCapWithoutImprovement;
+            break;
+        }
+    }
+
+    // Initial and every accepted incumbent were certified before publication.
+    // 최종적으로 가장 좋은 해로 맞춰 둔다.
+    sep.rollback(&best_sol, None);
+
+    info!(
+        "[PLSH] finished, {:.3} -> {:.3} (-{:.3}%)",
+        init_width,
+        best_sol.strip_width(),
+        (1.0 - best_sol.strip_width() / init_width) * 100.0
+    );
+
+    (
+        best_sol,
+        PolishStats {
+            rounds: round,
+            changes: total_changes,
+            exit,
+        },
+    )
+}
+
+fn pose_signature(sol: &SPSolution) -> Vec<(usize, u32, u32, u32)> {
+    let mut poses: Vec<_> = sol
+        .layout_snapshot
+        .placed_items
+        .values()
+        .map(|p| {
+            let (x, y) = p.d_transf.translation();
+            (
+                p.item_id,
+                p.d_transf.rotation().to_bits(),
+                x.to_bits(),
+                y.to_bits(),
+            )
+        })
+        .collect();
+    poses.sort_unstable();
+    poses
+}
+
+fn compactness(
+    sol: &SPSolution,
+) -> (
+    ordered_float::OrderedFloat<f64>,
+    ordered_float::OrderedFloat<f64>,
+) {
+    let mut poses: Vec<_> = sol
+        .layout_snapshot
+        .placed_items
+        .values()
+        .map(|p| {
+            (
+                p.item_id,
+                p.shape.bbox.x_max as f64,
+                p.shape.bbox.y_max as f64,
+            )
+        })
+        .collect();
+    poses.sort_by(|a, b| {
+        a.0.cmp(&b.0)
+            .then_with(|| a.1.total_cmp(&b.1))
+            .then_with(|| a.2.total_cmp(&b.2))
+    });
+    (
+        ordered_float::OrderedFloat(poses.iter().map(|p| p.1).sum()),
+        ordered_float::OrderedFloat(poses.iter().map(|p| p.2).sum()),
+    )
+}
