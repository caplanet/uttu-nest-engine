+        // the parent cancellation signal between resumable solver slices.
+        if config.lp.enabled && !grouped {
+            let lp_fraction = if config.slide.enabled || config.hole_fill.enabled {
+                0.60
+            } else {
+                1.0
+            };
+            let lp_term = FractionalTerminator::new(term, lp_fraction);
+            changes += lp::lp_compaction_pass_with_solver(sep, &config.lp, lp_solver, &lp_term);
+        }
+        if config.slide.enabled && !term.kill() {
