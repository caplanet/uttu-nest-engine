-            let errors = pool.install(|| {
-                self.lanes
-                    .par_iter_mut()
-                    .map(|lane| {
-                        let _scope = swarm_core::config::runtime::enter(run_control.clone());
-                        let term = SliceTerminator::until(stop, deadline);
-                        lane.run_slice(phase, &term, budget)
-                    })
-                    .collect::<Vec<_>>()
