-        }
-        h.solution = Some(committed);
-        h.prob = sep.prob;
-        h.phase = Phase::Exploration;
-        Ok(())
-    }));
-
-    match run {
-        Ok(Ok(())) => phase_success(),
-        Ok(Err(error)) => {
-            set_last_error(3005, error);
-            -1
-        }
-        Err(_) => {
