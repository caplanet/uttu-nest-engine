+pub fn polish_phase_with_nfp(
+    instance: &SPInstance,
+    sep: &mut Separator,
+    init_sol: &SPSolution,
+    sol_listener: &mut Option<&mut dyn SolutionListener>,
+    term: &impl Terminator,
+    config: &PolishConfig,
+    nfp_cfg: &crate::config::NfpIntegrationConfig,
+    lp_solver: &crate::lp_solver::LpSolverConfig,
+) -> SPSolution {
+    polish_phase_measured(
+        instance,
+        sep,
+        init_sol,
+        sol_listener,
+        term,
+        config,
+        nfp_cfg,
+        lp_solver,
+    )
+    .0
+}
