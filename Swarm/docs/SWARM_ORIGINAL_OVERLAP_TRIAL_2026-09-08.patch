-        }
-        let mut matched = 0;
-        for pi in solution.layout_snapshot.placed_items.values() {
-            if let Some(expected) = self.frozen_reference.get(&pi.item_id) {
-                if pi.d_transf != *expected {
-                    return false;
-                }
-                matched += 1;
-            }
-        }
