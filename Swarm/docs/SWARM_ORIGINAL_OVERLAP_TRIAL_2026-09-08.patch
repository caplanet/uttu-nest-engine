+/// 폴리시 계측치.
+#[derive(Debug, Clone, Copy)]
+pub struct PolishStats {
+    /// 완주한 라운드 수.
+    pub rounds: usize,
+    /// 모든 패스가 보고한 변경 건수의 합.
+    pub changes: usize,
+    /// 종료 사유.
+    pub exit: PolishExit,
+}
