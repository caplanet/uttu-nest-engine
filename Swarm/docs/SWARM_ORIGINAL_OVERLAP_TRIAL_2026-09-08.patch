-        P1CandidateRecord {
-            source,
-            start_index,
-            elapsed_secs,
-            complete,
-            exact_valid,
-            validation_error,
-            stopped,
-            width: selectable.then(|| solution.strip_width()),
-            density: selectable.then(|| solution.density(instance)),
-            improved_incumbent: false,
-            selected_as_p1_incumbent: false,
-            structure_hints,
-        },
-        selectable,
