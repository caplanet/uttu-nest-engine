+fn signature(eval: SampleEval) -> (u8, u32) {
+    match eval {
+        SampleEval::Invalid => (0, 0),
+        SampleEval::Clear { loss } => (1, loss.to_bits()),
+        SampleEval::Collision { loss } => (2, loss.to_bits()),
+    }
+}
