                            <TextBox Text="{Binding LpTimeLimitMs}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>

                        <Separator Margin="0,4,0,8"/>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NarrowCC Dist" Style="{StaticResource CfgLabel}" Grid.Column="0"
