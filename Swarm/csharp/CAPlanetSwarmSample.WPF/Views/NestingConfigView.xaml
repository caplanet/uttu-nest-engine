<UserControl x:Class="CAPlanetSwarmSample.WPF.Views.NestingConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:themes="http://schemas.actiprosoftware.com/winfx/xaml/themes"
             xmlns:bars="http://schemas.actiprosoftware.com/winfx/xaml/bars"
             xmlns:sp="clr-namespace:Uttu.NestingV2"
             xmlns:res="clr-namespace:CAPlanetSwarmSample.WPF.Resources"
             xmlns:local="clr-namespace:CAPlanetSwarmSample.WPF.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:NestingConfigViewModel}"
             themes:ThemeManager.DesignModeAreNativeThemesEnabled="True"
             themes:ThemeManager.DesignModeTheme="Dark"
             d:DesignHeight="850" d:DesignWidth="300">
    <UserControl.Resources>
        <Style x:Key="CfgLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="LightGray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="CfgBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static themes:AssetResourceKeys.ToolWindowContainerBackgroundNormalBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static themes:AssetResourceKeys.AutoHideTabItemBorderNormalBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style x:Key="CfgSection" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static themes:AssetResourceKeys.ContainerBackgroundLowestBrushKey}}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CfgHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <ObjectDataProvider x:Key="DecayOptions" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="sp:ShrinkDecayStrategy"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <Grid Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".5*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width=".5*"/>
                </Grid.ColumnDefinitions>

                <!-- General -->
                <Border Style="{StaticResource CfgSection}" Grid.Row="0">
                    <StackPanel>
                        <!-- 최적화 실행 순서: 위에서 아래로 실행, 같은 단계를 여러 번 넣을 수 있다. -->
                        <TextBlock Text="최적화 실행 순서" Style="{StaticResource CfgHeader}"
                                   ToolTip="위에서 아래로 실행합니다. 아래 목록에서 단계를 고르고 +로 추가하세요. 같은 단계를 여러 번 추가할 수 있습니다. 예: Explore → Explore → Compress → Polish. Structure를 켜면 이 순서는 사용하지 않습니다."
                                   ToolTipService.ShowDuration="500000"/>
                        <ItemsControl ItemsSource="{Binding PhaseEntries}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding DisplayName, Mode=OneWay}" IsReadOnly="True"
                                                 Style="{StaticResource CfgBox}" VerticalAlignment="Center"
                                                 ToolTip="추가한 단계를 보여 주는 읽기 전용 행입니다. 바꾸려면 이 행을 삭제하고 다시 추가하세요."/>
                                        <Button Grid.Column="1" Margin="4,0,0,0" Height="24" Padding="4"
                                                Command="{Binding DataContext.RemovePhaseCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="단계 삭제"
                                                ToolTip="이 행만 삭제합니다. 예: Explore가 두 번 있어도 선택한 행 하나만 삭제합니다.">
                                            <Viewbox Width="14" Height="16"><Canvas Width="24" Height="24">
                                                <Path Stroke="#F04B50" StrokeThickness="2" StrokeLineJoin="Round"
                                                      Data="M 4,6 L 20,6 M 8,6 L 8,3 L 16,3 L 16,6 M 6,6 L 7,22 L 17,22 L 18,6 M 10,10 L 10,18 M 14,10 L 14,18"/>
                                            </Canvas></Viewbox>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{x:Static local:NestingConfigViewModel.PhaseOptions}"
                                      SelectedItem="{Binding SelectedPhase, Mode=TwoWay}" IsEditable="False"
                                      VerticalAlignment="Center" AutomationProperties.Name="추가할 최적화 단계"
                                      ToolTip="Explore(탐색), Compress(압축), Polish(후처리) 중 선택하세요. 선택 후 +를 눌러야 목록 맨 아래에 추가됩니다. 예: Explore를 고르고 +를 누르면 탐색 단계가 하나 더 추가됩니다."/>
                            <Button Grid.Column="1" Margin="4,0,0,0" Height="24" Padding="3"
                                    Command="{Binding AddPhaseCommand}" AutomationProperties.Name="단계 추가"
                                    ToolTip="선택한 단계를 마지막 행에 추가합니다. 같은 단계를 여러 번 추가할 수 있습니다.">
                                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                                    <Ellipse Width="21" Height="21" Canvas.Left="1.5" Canvas.Top="1.5" Stroke="#00A8E8" StrokeThickness="2"/>
                                    <Path Stroke="#00A8E8" StrokeThickness="2" Data="M 12,6 L 12,18 M 6,12 L 18,12"/>
                                </Canvas></Viewbox>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding PhaseSequenceValidation}" TextWrapping="Wrap" Foreground="LightGray"
                                   FontSize="10" Margin="0,0,0,8"
                                   ToolTip="추가된 순서대로 실행하며 중단 또는 오류가 나면 이후 단계는 실행하지 않습니다. 전부 삭제한 경우 하나 이상 추가해야 실행할 수 있습니다. 각 단계는 직전 단계가 남긴 인증된 배치에서 출발합니다."/>

                        <TextBlock Text="General" Style="{StaticResource CfgHeader}"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PolySimpl" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.PolySimplTolerance_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding PolySimplTolerance}" Grid.Column="1">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource CfgBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MmSimplificationEnabled}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="최대 이탈(mm)" IsChecked="{Binding MmSimplificationEnabled}" Foreground="WhiteSmoke" FontSize="10" VerticalAlignment="Center"
                                      ToolTip="켜면 PolySimpl 면적 비율과 좁은 홈 닫기를 대체합니다. 간격·겹침을 적용한 도형에서 누적 최대 이탈을 mm로 제한하며, 조각은 바깥쪽으로만 단순화합니다. 실제 허용 겹침은 별도 설정입니다. Draft의 추가 면적 비율 단순화도 생략합니다. 값은 0보다 커야 합니다." ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding SimplifyMaxDeviationMm}" IsEnabled="{Binding MmSimplificationEnabled}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <bars:BarCheckBox IsChecked="{Binding MinItemSeparationEnabled}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="MinSep" Style="{StaticResource CfgLabel}"
                                       ToolTip="{x:Static res:TooltipResources.MinItemSeparation_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            </StackPanel>
                            <TextBox Text="{Binding MinItemSeparation}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding MinItemSeparationEnabled}"/>
                        </Grid>
                        <!-- ── NFP 기반 초기 배치 (NFP-LBF) / 적응형 탈출 ── -->
                        <Separator Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding NfpLbfEnabled}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="NFP 초기배치" Style="{StaticResource CfgLabel}"
                                       ToolTip="NFP Cache → Multiple Ordering → Sequential Placement 로 초기 배치 후보를 하나 더 만든다. (기본 켜짐)&#x0a;&#x0a;LBF 배치와 이 후보에 각각 짧은 탐색(조각 수에 따라 1 ~ 3초)을 돌려 더 좁아진 쪽을 탐색 seed 로 쓴다. 초기 길이만으로 고르면 자주 틀리기 때문이다 — 조각이 엇갈려 맞물린 배치는 처음에 조금 길어도 훨씬 많이 줄어든다.&#x0a;&#x0a;후보를 못 만들거나 초기 길이가 3% 넘게 길면 LBF 를 그대로 쓴다. Init 이 후보 탐색(아래 예산)과 대결(2 ~ 6초)만큼 길어진다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2" IsEnabled="{Binding NfpLbfEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  Orderings" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="평가할 배치 순서 개수. 많을수록 좋아지지만 느려진다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding NfpLbfOrderings}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2" IsEnabled="{Binding NfpLbfEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  Cache ms" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="NFP 콜드 캐시 생성 예산(ms). 초과하면 부분 캐시로 진행하고 나머지는 필요할 때 계산한다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding NfpLbfCacheBudgetMs}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2" IsEnabled="{Binding NfpLbfEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  Total ms" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="초기 배치 탐색 전체 예산(ms)."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding NfpLbfTotalBudgetMs}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2" IsEnabled="{Binding NfpLbfEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  Concave" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="NFP 전용 오목 단순화 강도(면적 증가 비율). 0 이면 비활성. 0.02 에서 캐시 생성이 2677ms → 162ms 로 줄고 밀도 손해는 없었다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding NfpLbfConcaveSimplify}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2" IsEnabled="{Binding NfpLbfEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  탐침 예산" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="아이템 하나당 feasible 판정을 시도할 후보 수 상한. 초기 배치 품질을 좌우한다. 실측(156패널, LBF = 69.45%): 1024 → 68.02% (LBF 에 져서 시드가 기각된다), 2048 → 69.90%, 4096 → 71.83% (기본값), 8192 → 72.08%. 전체 시간은 8초 → 14초."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding NfpLbfMaxProbes}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2" IsEnabled="{Binding NfpLbfEnabled}">
                            <bars:BarCheckBox IsChecked="{Binding NfpLbfAllow180}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="  NFP 0/180°" Style="{StaticResource CfgLabel}"
                                       ToolTip="NFP 초기배치에서 180도 회전을 함께 쓴다. 결방향 없는(non-nap) 원단 전용."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <bars:BarCheckBox IsChecked="{Binding EscapeEnabled}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="적응형 탈출" Style="{StaticResource CfgLabel}"
                                       ToolTip="정체 감지 기반 적응형 국소 최적해 탈출로 탐색 단계를 교체한다. Level 1~3 교란 + Conflict Burst + Swarm 다양화."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="겹침 허용(mm)" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="조각 사이에 허용할 겹침(mm). Draft Init의 접촉 탐색과 최종 충돌 판정에도 적용됩니다. 0이면 겹침을 허용하지 않으며, 양수이면 MinSep보다 우선합니다. 원단 경계 밖 배치는 허용하지 않습니다. 이용률 개선 정도는 입력과 배치 순서에 따라 달라집니다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding PieceOverlapMm}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="겹침 초과 배치" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="겹침 허용을 켜면 탐색은 조각을 허용값의 절반만큼 줄인 도형으로 하고, 결과를 원래 외곽선으로 다시 검증합니다. 뾰족한 꼭짓점은 줄이기에서 더 깎이므로, 줄인 도형은 겹치지 않아도 원래 외곽선은 허용값보다 깊이 겹칠 수 있습니다(로그: [ORIGINAL:VALIDATE] original overlap exceeds configured piece_overlap_mm).&#10;&#10;실현 불가능(기본): 그런 배치를 버리고 직전에 인증된 배치를 유지합니다.&#10;실현 가능: 원래 외곽선 검증을 끄고 그대로 채택합니다. 겹침은 줄인 도형으로만 판정하므로 뾰족한 꼭짓점이 허용값보다 깊이 파고들 수 있습니다. 원단 경계 검사는 그대로입니다.&#10;&#10;겹침 허용이 0이면 효과가 없습니다."
                                       ToolTipService.ShowDuration="500000"/>
                            <ComboBox SelectedIndex="{Binding OriginalOverlapPolicyIndex}"
                                      FontSize="10" Height="22" Grid.Column="1">
                                <ComboBoxItem Content="실현 불가능 (버림, 기본)"/>
                                <ComboBoxItem Content="실현 가능 (채택)"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="그룹 배치 방식" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="place_groups(패턴 그룹)를 엔진에 넘기는 방식입니다.&#10;&#10;다중 폴리곤(기본): 그룹마다 멤버 외곽선을 힌트 자세대로 합친 아이템 하나를 만듭니다. 멤버 상대 자세는 정의상 정확하고, 멤버 사이 틈에는 다른 조각이 들어갈 수 있습니다.&#10;강체 이동: 멤버를 별도 조각으로 두고 상대 좌표로 함께 옮깁니다(1.0.2 까지의 방식)."
                                       ToolTipService.ShowDuration="500000"/>
                            <ComboBox SelectedIndex="{Binding PlaceGroupModeIndex}"
                                      FontSize="10" Height="22" Grid.Column="1">
                                <ComboBoxItem Content="다중 폴리곤 아이템 (기본)"/>
                                <ComboBoxItem Content="강체 이동 (기존)"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="원단 밖 허용(mm)" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="조각의 원본 외곽선이 원단 밖으로 넘어도 되는 최대 거리(mm). 0이면 검사하지 않습니다. 겹침을 허용하면 충돌 도형이 침식되는데, 침식은 볼록 꼭짓점을 변보다 깊이 끌어당기므로 컨테이너를 같은 양만큼 줄여도 원본 꼭짓점은 밖으로 나갑니다. 실측(꼭짓각 31.7도, 겹침 0.8mm)에서 최대 0.35mm 이탈했습니다. 값을 주면 각 단계 결과를 공개하기 직전에 넘은 조각만 안쪽으로 밀며, 막는 이웃까지 함께 밀어 겹침 계약은 유지됩니다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding FabricEdgeMarginMm}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <!-- ── 초기 구성기 / 구간 완성 (ABI v17) ── -->
                        <TextBlock Text="초기 구성기" Margin="0,6,0,2"
                                   Foreground="#FFB0C4DE" FontSize="11" FontWeight="Bold"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="구간 완성 폭(mm)" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="현재 세로 구간이 더 받아들이지 못할 때까지 프론티어를 오른쪽으로 밀지 않습니다. 0이면 끕니다. 여성WSjk 156-패널, 겹침 0.8mm 실측에서 300mm가 초기 밀도를 73.350%에서 73.903%로 올렸습니다. 폭에 대한 반응은 단조롭지 않습니다 - 같은 실측에서 200mm는 오히려 3.5%p 나빴으므로 마커마다 확인이 필요합니다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding ConstructorBandWidthMm}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>

                        <!-- ── 탐색 단계 NFP 활용 (전부 기본 꺼짐, A/B 측정용) ── -->
                        <TextBlock Text="탐색 단계 NFP 활용" Margin="0,6,0,2"
                                   Foreground="#FFB0C4DE" FontSize="11" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding NfpOrderingExploration}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="순수 NFP 순서탐색" Style="{StaticResource CfgLabel}"
                                       ToolTip="탐색 단계를 통째로 교체한다. 겹침을 한 번도 허용하지 않고 배치 순서를 탐색 공간으로 삼는다. 적응형 탈출보다 우선한다. 연속 완화가 주는 마지막 몇 %를 잃을 수 있으니 반드시 A/B 로 비교할 것."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding NfpSampler}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="① NFP 샘플러" Style="{StaticResource CfgLabel}"
                                       ToolTip="separator 의 위치 샘플러를 NFP 후보로 교체한다. 기존은 컨테이너에 난수를 뿌려 좁은 포켓을 확률적으로 놓친다. NFP 는 유효 위치를 정확히 열거하고 후보가 전부 접촉 위치라 자동으로 밀착된다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding NfpExactSeparationVector}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="② 정확한 분리벡터" Style="{StaticResource CfgLabel}"
                                       ToolTip="Conflict Burst 의 EscapeVector 가 쓰는 분리 벡터를 정확한 NFP 기반으로 바꾼다. 기존은 bbox MTV 근사라 오목한 의류 패턴에서 실제 최소 분리 방향과 크게 어긋난다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>

                        <Separator Margin="0,8,0,4"/>
                        <TextBlock Text="NFP 초기배치 전략" FontWeight="Bold" Margin="0,0,0,4"
                                   ToolTip="초기 배치를 만드는 방식을 바꾼다. 각 항목은 파이프라인의 다른 지점에 붙으므로 대부분 함께 켤 수 있다. 전부 끄면 기존 NFP-LBF 경로가 그대로 돈다."
                                   ToolTipService.ShowDuration="500000"/>

                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategyInstanceRotations}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="① 인스턴스 회전" Style="{StaticResource CfgLabel}"
                                       ToolTip="회전 후보를 allow_180 플래그가 아니라 인스턴스가 선언한 allowed_orientations 에서 그대로 뽑는다. 기존 LBF 생성기는 이미 그렇게 한다. 실측(albano, [0,180]): 끄면 LBF 대비 -1.51%p 로 지고, 켜면 +8.57%p 로 이긴다. 회전 선언이 [0] 뿐인 인스턴스는 영향이 없다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2" IsEnabled="{Binding StrategyInstanceRotations}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  회전 간격°" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="연속 회전(Continuous)을 몇 도 간격으로 샘플링할지. 작을수록 촘촘하지만 pair NFP 가 그 제곱으로 늘어난다. 캐시 예산을 함께 늘려야 한다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding StrategyRotationStepDeg}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategyPairwiseClustering}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="② 쌍별 클러스터링" Style="{StaticResource CfgLabel}"
                                       ToolTip="잘 맞물리는 조각 쌍을 하나의 super-piece 로 묶어 배치한다. 의류 마커에서 좌/우 대칭 패널과 소매는 짝지어 놓을 때 낭비가 급감하는데, 순차 배치는 조각을 하나씩 보므로 그 짝을 스스로 찾지 못한다. 쌍의 상대 위치는 NFP 경계 위에서 고르므로 정의상 겹치지 않는다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2" IsEnabled="{Binding StrategyPairwiseClustering}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  쌍 최소 이득" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="쌍을 채택할 최소 충전율 이득. 너무 낮으면 이득 없는 쌍까지 묶여 배치 자유도만 잃는다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding StrategyClusterMinGain}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategyContactMaximization}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="③ 접촉 최대화" Style="{StaticResource CfgLabel}"
                                       ToolTip="후보 위치를 '가장 왼쪽' 이 아니라 '접촉 최대' 로 고른다 (Gomes &amp; Oliveira). 기존 우선순위는 사실상 argmin(x) 로 붕괴한다 — 폭 W 가 상수라 strip_length = max(frontier, x+W) 가 x 의 단조 증가 함수이고, 따라서 1순위가 2순위를 절대 뒤집지 못한다. 실측(탐침 8192): 72.08% → 72.48%. 탐침 예산이 낮으면 이득이 없다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategyPocketFirst}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="④ 포켓 우선" Style="{StaticResource CfgLabel}"
                                       ToolTip="프론티어를 늘리기 전에 이미 배치된 영역 안쪽의 구멍부터 채운다. 탐침 예산은 프론티어 근처에 몰려 있어 안쪽 구멍은 예산이 닿기 전에 끝나는데, 이 전략은 순서를 뒤집어 내부 후보를 먼저 전량 훑는다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategyBeamSearch}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="⑤ 빔 서치" Style="{StaticResource CfgLabel}"
                                       ToolTip="각 깊이에서 부분 배치를 1개가 아니라 여러 개 유지한다. 순차 배치는 되돌아갈 수 없어서 초반 한 번의 나쁜 선택이 끝까지 가는데, 빔은 그 선택을 유예한다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2" IsEnabled="{Binding StrategyBeamSearch}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  빔 폭" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="유지할 부분 배치 수. 비용과 시간이 이 값에 정비례한다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding StrategyBeamWidth}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategyBestFit}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="⑥ best-fit 선택" Style="{StaticResource CfgLabel}"
                                       ToolTip="배치 순서를 미리 정하지 않고, 매 단계 남은 조각 전체를 평가해 가장 잘 맞는 조각을 고른다 (first-fit 이 아니라 best-fit). 켜면 ordering 목록은 평가 시작점으로만 쓰인다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2" IsEnabled="{Binding StrategyBestFit}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  평가 조각수" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="매 단계 평가할 남은 조각 종류 수 상한. 전수 평가는 O(남은 조각 x 후보) 라 감당이 안 되므로 면적 내림차순 상위 이만큼만 본다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding StrategyBestFitLookahead}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategySlidingCompaction}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="⑦ 슬라이딩 압축" Style="{StaticResource CfgLabel}"
                                       ToolTip="배치가 끝난 뒤 각 조각을 막힐 때까지 좌하단으로 민다. 그리디 배치는 나중 조각이 앞 조각을 밀어낼 수 없어 틈을 남기는데, 이 패스가 그 틈을 회수한다. NFP 기반이라 겹침이 생길 수 없고 회전은 바꾸지 않는다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2" IsEnabled="{Binding StrategySlidingCompaction}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  압축 라운드" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="슬라이딩을 몇 라운드 돌릴지. 한 라운드는 모든 조각을 한 번씩 훑는다. 개선이 없으면 남은 라운드를 건너뛴다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding StrategySlidingRounds}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategyAccretion}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="⑧ 누적 배치" Style="{StaticResource CfgLabel}"
                                       ToolTip="배치 순서를 아예 정하지 않고, 매 단계 남은 조각 전체 x 가능한 자리 전체에서 가장 잘 맞물리는 (조각, 자리) 한 쌍을 고른다. ⑥ best-fit 과 달리 ordering 을 쓰지 않으므로 켜면 ordering 을 1개만 평가한다. 실측(wsjk156, 탐침 8192): 71.75% → 72.93%, ⑦ 슬라이딩을 얹으면 73.09%. 26초 걸리던 최고 조합(72.18%)보다 좋으면서 훨씬 싸다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding StrategyTailReflow}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="⑨ 꼬리 회수" Style="{StaticResource CfgLabel}"
                                       ToolTip="오른쪽 끝(꼬리)의 조각을 빼서 앞쪽에 남은 빈 곳으로 되돌린다. 그리디 배치는 앞을 조이고 뒤를 굶긴다 — 경쟁사 마커와 200mm 구간별 충전율을 대조하면 앞 1/3 은 -1.7%p 인데 뒤 1/3 이 -15.4%p 로 벌어진다. ⑦ 슬라이딩과 성격이 다르다: ⑦은 조각을 제자리 근처로 밀고, ⑨는 꼬리에서 앞쪽 포켓으로 멀리 옮긴다. 실측(5초 예산): 71.75% → 73.27%."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2" IsEnabled="{Binding StrategyTailReflow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  회수 라운드" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="꼬리 회수를 몇 라운드 돌릴지. 뺀 조각을 전부 다시 넣지 못한 라운드는 통째로 원복한다 — 미배치를 남기는 것은 폭을 못 줄인 것보다 훨씬 나쁘기 때문이다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding StrategyReflowRounds}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>

                        <Separator Margin="0,8,0,4"/>
                        <TextBlock Text="실험 — 레퍼런스 설계 엔진" FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="#B85C00"
                                   ToolTip="레퍼런스 설계 문서를 그대로 구현한 별도 초기배치 엔진이다. 구조 검증용이며 품질이 아직 기존 경로에 크게 못 미친다. 실측(wsjk156): 기존 NFP-LBF 71.75% / 전략 8+7+9 73.72% / 경쟁사 82.28% / 이 엔진 25.04%."
                                   ToolTipService.ShowDuration="500000"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding RefPlaceEnabled}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="설계 엔진으로 대체" Style="{StaticResource CfgLabel}"
                                       ToolTip="켜면 기존 초기 배치를 이 엔진으로 통째로 대체한다. 시드로 비교해 좋은 쪽을 고르는 것이 아니다 — 지금 품질 차이가 커서 비교로 넣으면 언제나 기존 쪽이 이겨 이 엔진이 도는지조차 확인할 수 없기 때문이다. 앞 5,200mm 구간의 충전율은 76%로 경쟁사(81%)에 크게 뒤지지 않지만, 그 뒤로 NFP 차감이 실패하기 시작해 남은 조각이 프론티어 오른쪽으로 일렬로 밀린다. 실행 로그의 [INIT] refplace 줄에서 폴백 횟수를 볼 수 있다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2" IsEnabled="{Binding RefPlaceEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  그룹 대체" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="설계의 제1원칙은 '순서 = 그룹 정의 기반' 인데, 입력의 그룹 메타데이터(domain 블록)를 솔버 로더가 버리므로 지금은 대체 규칙만 쓸 수 있다. 0 = 조각 하나가 한 그룹(부착 체인이 생기지 않는다), 1 = 같은 조각의 사본끼리 한 그룹."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding RefPlaceGroupFallback}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>

                        <Separator Margin="0,8,0,4"/>
                        <TextBlock Text="LP·QP 솔버" FontWeight="Bold" Margin="0,0,0,4"
                                   ToolTip="압축 단계의 선형계획을 어떤 엔진으로 풀지. Clp 와 Xpress 는 빌드에 링크하지 않고 런타임에 DLL 을 찾는다 — 없으면 폴백 설정에 따른다."
                                   ToolTipService.ShowDuration="500000"/>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  엔진" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="0 = microlp (단체법, 순수 Rust, 항상 사용 가능, LP 전용).  1 = clarabel (내점법/barrier, 순수 Rust, QP 지원).  2 = COIN-OR Clp (런타임에 clp.dll 을 찾는다, LP 전용).  3 = FICO Xpress (런타임에 xprs.dll, LP+QP, 라이선스 필요). 범위 밖이면 0."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding LpBackendIndex}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  QP 계수" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="2차 정규화 계수. 0 이면 순수 LP. 순수 LP 는 목적이 폭 최소화 하나뿐이라 폭이 같은 해가 무수히 많고, 그중 아무거나 고르면 조각이 불필요하게 멀리 튄다. 2차항을 얹으면 같은 폭이면 덜 움직이는 해가 유일하게 뽑힌다. LP 전용 엔진(0, 2)에서는 무시된다."
                                       ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding LpQuadraticRegularization}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <bars:BarCheckBox IsChecked="{Binding LpFallback}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="  솔버 폴백" Style="{StaticResource CfgLabel}"
                                       ToolTip="선택한 엔진을 쓸 수 없을 때 microlp 로 물러난다. 끄면 압축 단계를 통째로 건너뛴다 — 상용 솔버 결과를 재현해야 하는 검증 실행에서는 조용한 폴백이 오히려 해롭기 때문에 선택지로 남긴다."
                                       ToolTipService.ShowDuration="500000"/>
                        </StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  제한 ms" Style="{StaticResource CfgLabel}" Grid.Column="0"
