                                   ToolTip="한 회수 사이클에서 남은 시간의 몇 할을 압축에 줄지 (0.0~1.0, 나머지는 폴리시). 압축이 폭을 줄이고 폴리시가 그 결과를 다듬는 구조라 압축 쪽이 커야 한다. 폴리시 몫은 최소 5%가 보장된다. 0 이하면 네이티브 기본값 0.75."
                                   ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding ReclaimCompressShare}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding ReclaimLeftoverEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="  사이클 상한" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="회수 사이클 수의 상한. 0 이면 예산이 다할 때까지 돈다. 사이클 수가 실측 잔여 시간의 함수라 빠른 기계에서 더 많이 돌고 결과가 달라진다 — 재현 가능한 실행이 필요하면 이 값을 고정하라."
                                   ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding ReclaimMaxCycles}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding ReclaimLeftoverEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Slide" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.SlideEnabled_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <CheckBox IsChecked="{Binding SlideEnabled}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SlidePasses" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.SlideNumPasses_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding SlideNumPasses}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding SlideEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SlideDown" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.SlideDown_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <CheckBox IsChecked="{Binding SlideDown}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SlideSafety" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.SlideSafetyRatio_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding SlideSafetyRatio}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding SlideEnabled}"/>
                        </Grid>

                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LP" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.LpEnabled_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <CheckBox IsChecked="{Binding LpEnabled}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LP Iters" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.LpNumIterations_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding LpNumIterations}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding LpEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LP TrustRegion" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.LpTrustRegionRatio_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding LpTrustRegionRatio}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding LpEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LP LeftPull" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.LpLeftPullWeight_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding LpLeftPullWeight}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding LpEnabled}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- LBF Raster NFP (capmods 전용) -->
                <Border Style="{StaticResource CfgSection}" Grid.Row="3" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="LBF Raster NFP" Style="{StaticResource CfgHeader}"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Enabled" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.RasterEnabled_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <CheckBox IsChecked="{Binding RasterEnabled}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CellRatio" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.RasterCellRatio_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding RasterCellRatio}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding RasterEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MaxCells" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.RasterMaxCells_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding RasterMaxCells}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding RasterEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Candidates" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.RasterNumCandidates_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding RasterNumCandidates}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding RasterEnabled}"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RandomSamples" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.RasterNumRandomSamples_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding RasterNumRandomSamples}" Style="{StaticResource CfgBox}" Grid.Column="1"
                                 IsEnabled="{Binding RasterEnabled}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 회전 자유도 (결방향 없는 원단 전용) -->
                <Border Style="{StaticResource CfgSection}" Grid.Row="4">
                    <StackPanel>
                        <TextBlock Text="Rotation" Style="{StaticResource CfgHeader}"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Allow 180°" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.Allow180Rotation_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <CheckBox IsChecked="{Binding Allow180Rotation}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tilt ± (deg)" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                   ToolTip="{x:Static res:TooltipResources.TiltRangeDeg_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <TextBox Text="{Binding TiltRangeDeg}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- V2 lane scheduler와 Structure First 실행 설정 -->
                <Border Style="{StaticResource CfgSection}" Grid.Row="4" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Swarm Grouping / Structure" Style="{StaticResource CfgHeader}"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Group Workers" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="V2 size_regions lane을 동시에 실행할 worker 수입니다. 권장값은 movable lane 수와 논리 프로세서 수 중 작은 값입니다. quantum_ms는 별도 UI에서 덮지 않고 입력 JSON 계약값을 그대로 사용합니다."/>
                            <TextBox Text="{Binding GroupWorkers}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Structure Enabled" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="Init 직후 P0-P5 structure-first 대체 파이프라인을 실행합니다. 기본값은 OFF입니다."/>
                            <CheckBox IsChecked="{Binding StructureFirstEnabled}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Soft Motif" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="P0에서 reversible pair/block/band 후보를 생성합니다."/>
                            <CheckBox IsChecked="{Binding StructureMotifEnabled}" VerticalAlignment="Center" Grid.Column="1"
                                      IsEnabled="{Binding StructureFirstEnabled}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Callback interval and payload diagnostics (모든 실행 모드 공통) -->
                <Border Style="{StaticResource CfgSection}" Grid.Row="5" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Callback Options" Style="{StaticResource CfgHeader}"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Interval (ms)" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="중간 결과 callback 통지 간격입니다. Explore/Compress/Polish/Structure 모두에 적용됩니다. 기본값은 2000ms이고 500 미만의 값은 500ms로 보정됩니다. 단계 종료 결과는 즉시 전달됩니다."/>
                            <TextBox Text="{Binding StructureProgressCallbackIntervalMs}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Collect Loss" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="콜백 JSON에 loss 필드를 포함합니다. JSON이 실리는 보고(CmprFeas/Final)는 모두 실행 가능한 해라 값은 사실상 항상 0입니다. Solver 내부 Loss와 exact 검증에는 영향이 없습니다."/>
                            <CheckBox IsChecked="{Binding CallbackCollectLoss}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Collision Status" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                       ToolTip="콜백 JSON에 아이템별 충돌 상태를 포함합니다. 끄면 중간 결과의 충돌 강조를 생략합니다."/>
                            <CheckBox IsChecked="{Binding CallbackCollectCollisionStatus}" VerticalAlignment="Center" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- N06 독립 초기배치 엔진 (Initial Placement) -->
                <Border Style="{StaticResource CfgSection}" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Initial Placement (N06)" Style="{StaticResource CfgHeader}" Grid.Column="0"
                                       ToolTip="{x:Static res:TooltipResources.InitEnabled_Tooltip}" ToolTipService.ShowDuration="500000"/>
                            <CheckBox IsChecked="{Binding InitEnabled}" VerticalAlignment="Center" Margin="8,0,0,0" Grid.Column="1"
                                      ToolTip="{x:Static res:TooltipResources.InitEnabled_Tooltip}" ToolTipService.ShowDuration="500000"/>
                        </Grid>
                        <Grid IsEnabled="{Binding InitEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".5*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width=".5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time Limit (s)" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitTimeLimitSecs_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitTimeLimitSecs}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GRASP Starts" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitGrasp_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitGrasp}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Kicks" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitKicks_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitKicks}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Step0 Frac" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitStep0Frac_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitStep0Frac}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Min Frac" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitMinFrac_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitMinFrac}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Iter Cap" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitIterCap_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitIterCap}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Samples Base" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitSamplesBase_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitSamplesBase}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GLS Growth" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitGrowth_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitGrowth}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rescue After" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitRescueAfter_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitRescueAfter}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Stall Cap" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitStallCap_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitStallCap}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CD Min (mm)" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitCdMin_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitCdMin}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Compact Passes" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitCompactPasses_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitCompactPasses}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reseat Top" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitReseatTop_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitReseatTop}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Cand Eval Cap" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitCandEvalCap_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitCandEvalCap}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LBF X Weight" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitLbfXWeight_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitLbfXWeight}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LBF Y Weight" Style="{StaticResource CfgLabel}" Grid.Column="0"
                                           ToolTip="{x:Static res:TooltipResources.InitLbfYWeight_Tooltip}" ToolTipService.ShowDuration="500000"/>
                                    <TextBox Text="{Binding InitLbfYWeight}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
