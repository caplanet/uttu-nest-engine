                            <TextBox Text="{Binding NarrowConcavityCutoffDist}" Style="{StaticResource CfgBox}" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
