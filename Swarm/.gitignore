# Generated by Cargo
# will have compiled files and executables
**/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm and Rider
**/.idea/

# VSCode
**/.vscode/

/output/

**/.live_solution.svg

# Rust 빌드 결과물
/target/

# C# 빌드 결과물 (csharp 하위 모든 프로젝트)
**/bin/
**/obj/

# 프로젝트 출력 디렉터리
/output/
/out/

# Visual Studio
/.vs/
*.suo
*.user

# Keep reproducible Cargo settings, ignore other local Cargo files.
/.cargo/*
!/.cargo/config.toml

/Cargo.lock

# Visual Studio
*wpftmp.csproj

# nesting-engine CLI 소스는 C# 출력 규칙(**/bin/)에서 제외한다
!/nesting-engine/src/bin/

# Local benchmark measurements, logs, and result reports (keep harness sources).
/benchmarks/input-conversion/results/
/benchmarks/input-conversion/RESULTS-*.md
